{
  "name": "Association",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "FK to User"
    },
    "association_name": {
      "type": "string"
    },
    "association_type": {
      "type": "string",
      "enum": [
        "Condominium",
        "Homeowners Association",
        "Cooperative",
        "Community Development District",
        "Condo-Hotel",
        "Dockominium",
        "Commercial Association",
        "Mixed-Use Association",
        "Mobile Home and Manufactured Housing Community"
      ]
    },
    "florida_county": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "street_address": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "phone_number": {
      "type": "string"
    },
    "number_of_units": {
      "type": "number"
    },
    "management_company_name": {
      "type": "string"
    },
    "association_description": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "sample_coi_url": {
      "type": "string"
    },
    "subscription_tier": {
      "type": "string",
      "default": "free"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "resident_signup_link": {
      "type": "string"
    },
    "require_coi": {
      "type": "boolean",
      "default": true
    },
    "require_trade_license": {
      "type": "boolean",
      "default": true
    },
    "require_workers_comp": {
      "type": "boolean",
      "default": true
    },
    "require_sunbiz": {
      "type": "boolean",
      "default": true
    },
    "gl_minimum_coverage": {
      "type": "number"
    },
    "auto_approve_if_compliant": {
      "type": "boolean",
      "default": false
    },
    "custom_compliance_notes": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "association_name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.onboarding_complete": true
        }
      ]
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}