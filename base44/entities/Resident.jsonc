{
  "name": "Resident",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "FK to User"
    },
    "association_id": {
      "type": "string",
      "description": "FK to Association"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "street_address": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "default": "FL"
    },
    "zip_code": {
      "type": "string"
    },
    "resident_type": {
      "type": "string"
    },
    "primary_phone": {
      "type": "string"
    },
    "secondary_phone": {
      "type": "string"
    },
    "move_in_date": {
      "type": "string",
      "format": "date"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "association_id",
    "first_name",
    "last_name",
    "email"
  ]
}