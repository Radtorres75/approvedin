{
  "name": "VendorInvitation",
  "type": "object",
  "properties": {
    "association_id": {
      "type": "string",
      "description": "FK to Association"
    },
    "sent_by_user_id": {
      "type": "string"
    },
    "recipient_email": {
      "type": "string"
    },
    "recipient_phone": {
      "type": "string"
    },
    "invitation_method": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "both"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "delivered",
        "accepted",
        "failed"
      ],
      "default": "pending"
    },
    "delivery_error_message": {
      "type": "string"
    },
    "registration_link": {
      "type": "string"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "association_id",
    "invitation_method"
  ]
}