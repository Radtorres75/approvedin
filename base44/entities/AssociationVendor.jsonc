{
  "name": "AssociationVendor",
  "type": "object",
  "properties": {
    "association_id": {
      "type": "string",
      "description": "FK to Association"
    },
    "vendor_id": {
      "type": "string",
      "description": "FK to Vendor"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "suspended",
        "archived"
      ],
      "default": "pending"
    },
    "compliance_score": {
      "type": "number",
      "default": 0
    },
    "approved_date": {
      "type": "string",
      "format": "date"
    },
    "rejected_date": {
      "type": "string",
      "format": "date"
    },
    "rejection_reason": {
      "type": "string"
    },
    "suspended_date": {
      "type": "string",
      "format": "date"
    },
    "suspension_reason": {
      "type": "string",
      "enum": [
        "noncompliance_auto",
        "manager_manual"
      ]
    },
    "reactivated_date": {
      "type": "string",
      "format": "date"
    },
    "is_visible_in_resident_directory": {
      "type": "boolean",
      "default": false
    },
    "added_by": {
      "type": "string",
      "enum": [
        "manager_invited",
        "vendor_applied"
      ]
    }
  },
  "required": [
    "association_id",
    "vendor_id"
  ]
}