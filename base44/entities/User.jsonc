{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "association_manager",
        "vendor",
        "resident"
      ],
      "description": "User role - set at registration, never changes"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "phone_number": {
      "type": "string"
    },
    "profile_complete": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_login_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "role",
    "first_name",
    "last_name"
  ]
}