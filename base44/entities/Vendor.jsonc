{
  "name": "Vendor",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "FK to User"
    },
    "business_name": {
      "type": "string"
    },
    "business_description": {
      "type": "string"
    },
    "business_phone": {
      "type": "string"
    },
    "business_email": {
      "type": "string"
    },
    "business_website": {
      "type": "string"
    },
    "years_in_business": {
      "type": "number"
    },
    "logo_url": {
      "type": "string"
    },
    "trade_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Multi-select trade categories"
    },
    "florida_counties_served": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sunbiz_registration_number": {
      "type": "string"
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "beta",
        "paid"
      ],
      "default": "beta"
    },
    "beta_signup_date": {
      "type": "string",
      "format": "date"
    },
    "profile_completion_percentage": {
      "type": "number",
      "default": 0
    },
    "setup_current_step": {
      "type": "number",
      "default": 0
    },
    "setup_highest_completed_step": {
      "type": "number",
      "default": 0
    },
    "overall_compliance_status": {
      "type": "string",
      "enum": [
        "compliant",
        "expiring_soon",
        "noncompliant"
      ],
      "default": "noncompliant"
    },
    "is_suspended": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "business_name"
  ]
}