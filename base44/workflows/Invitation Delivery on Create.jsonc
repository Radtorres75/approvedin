{
  "name": "Invitation Delivery on Create",
  "description": "Automatically attempts delivery (email/SMS) immediately when a VendorInvitation record is created.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "VendorInvitation"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "invitation_delivery_on_create",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendVendorInvitation",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendVendorInvitation"
  }
}